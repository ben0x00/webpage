---
const currentPath = Astro.url.pathname;
---
<footer id="page-footer">
    <nav id="navigation-bar">
        <div id="div-navigation-links">
            <ul class="nav-links">
                <li>1</li>
                <li>2</li>
            </ul>
        </div>

        <div id="div-navigation-buttons">
            <ul class="nav-buttons">
                <li><a class={currentPath==='/' ? 'is-active' : '' } href="/">Home</a></li>
                <li><a class={currentPath==='/projects' ? 'is-active' : '' } href="/projects">Projects</a></li>
                <li><a class={currentPath==='/posts' ? 'is-active' : '' } href="/posts">Posts</a></li>
            </ul>
        </div>
    </nav>
</footer>

<style lang="scss">
    @use 'sass:map';
    @use '../styles/typography';
    @use '../styles/variables';

    #page-footer {
        grid-row: 2;
        grid-column: 1;
        border-top: 2px solid map.get(variables.$colours, border-dark);
        background-color: map.get(variables.$colours, bg-main);
        z-index: 1;
    }

    #navigation-bar {
        display: grid;

        grid-template-columns: clamp(170px, 24vw, 240px) minmax(0, 1fr);


        align-items: center;

        #div-navigation-links,
        #div-navigation-buttons {
            display: flex;
            justify-content: center;
        }

        #div-navigation-links {
        }

        #div-navigation-buttons {
            min-width: 265px;
        }

        .nav-links,
        .nav-buttons {
            display: flex;
            list-style: none;
            padding: 0;
            margin: .75rem;
        }

        .nav-links {
            justify-content: space-around;
            margin: 0;
            width: 100%;
        }

        .nav-buttons {
            display: flex;
            justify-content: center;
            width: 100%;
            gap: .75rem;
        }

        .nav-buttons a {
            padding: .5rem 1rem;
            border: 2px dashed map.get(variables.$colours, accent);
            border-radius: 5px;
            background: map.get(variables.$colours, bg-pane-right);
            color: map.get(variables.$colours, accent);

            font-family: map.get(typography.$fonts, mono);
            text-decoration: none;

            transition: background 0.3s ease, color 0.1s linear, border-color 0.25s ease, transform 0.2s ease;
        }

        .nav-buttons a.is-active {
            background: map.get(variables.$colours, accent);
            color: map.get(variables.$colours, bg-main);
            border-style: solid;
            border-color: map.get(variables.$colours, secondary);
        }

        .nav-buttons a:hover {
            transform: translateY(1.5px);
        }

        .nav-buttons a:not(.is-active):hover {
            background: rgb(0, 0, 0, 0.05);
            border-style: solid;
            transform: translateY(1.5px);
        }
    }

    @media (max-width: 400px) { // Shrink links on small screens
            #navigation-bar {
                grid-template-columns: clamp(75px, 10vw, 170px) minmax(0, 1fr);
            }
        }
</style>