---
import TownSquare from '../components/TownSquare.astro'
import InfoCard from '../components/InfoCard.astro'
---

<p class="intro-text">Welcome to my redesigned website! It's heavily work in progress at the
    moment, so expect things to be broken for the time being.<br><br>
    Eventually, blog posts and projects will be showcased here.</p>
<section class="profile-updates">
    <h2 class="section-label">Recent Updates</h2>
    <div class="updates-list">
        <div class="update-item">
            <span class="update-date">Apr 29 2026</span>
            <span class="update-tag">Website</span>
            <span class="update-message">Redesign launch???</span>

        </div>
    </div>
</section>


<h2 class="section-label">// Links</h2>
<div class="info-cards-grid">
    <InfoCard label="Item 1" content="Content" />
    <InfoCard label="Item 2" content="Content" />
</div>

<TownSquare />