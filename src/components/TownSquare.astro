---
const {
    title = 'Town square',
    caption = 'Everyone reading this page right now. Move around with the arrow keys.',
} = Astro.props;
---

<section class="townsquare">
    <h2 class="section-label">{title}</h2>
    <div class="townsquare__frame">
        <div id="townsquare-root"></div>
    </div>
    <p class="townsquare__caption">{caption}</p>
</section>

<link rel="stylesheet" href="https://townsquare.cauenapier.com/widget.css" />
<script type="module">
    import { mountTownSquare } from "https://townsquare.cauenapier.com/townsquare.mjs";

    mountTownSquare(document.getElementById("townsquare-root"), {
        serverOrigin: "https://townsquare.cauenapier.com",
        siteKey: "site_lNSdQI6i2Np3dlZW",
        scene: { "benches": 2, "benchXs": [0.2, 0.72], "trees": 6, "treeXs": [0.2, 0.58, 0.36, 0.9, 0.05, 0.68], "lamps": 4, "lampXs": [0.12, 0.88, 0.36, 0.64], "birds": 3 },
        theme: "host"
    });
</script>

<style lang="scss">
    @use 'sass:map';
    @use '../styles/typography';
    @use '../styles/variables';

    .townsquare__frame {
        border: map.get(variables.$border, regular) solid map.get(variables.$colours, border-dark);
        border-radius: map.get(variables.$radius, md);
        box-shadow: variables.$shadow-offset variables.$shadow-offset 0 map.get(variables.$colours, shadow);
        overflow: hidden;
    }

    .townsquare__caption {
        font-family: map.get(typography.$fonts, body);
        font-size: var(--step--1);
        color: map.get(variables.$colours, text-muted);
        line-height: 1.5;
        margin: map.get(variables.$spacing, sm) 0 0;
    }
</style>