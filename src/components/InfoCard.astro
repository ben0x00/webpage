---
const {label="Placeholder", content="Placeholder", link=""} = Astro.props;
---

<a class="info-card" href={link} >
    <p class="card-label">{label}</p>
    <p class="card-value">{content}</p>
</a>

<style lang="scss">
@use 'sass:map';
@use '../styles/typography';
@use '../styles/variables';

    .info-card{
    background-color: map.get(variables.$colours, card-bg);
    border: 1.5px solid map.get(variables.$colours, border-dark);
    border-radius: 5px;
    padding: map.get(variables.$spacing, md);
    box-shadow: 4px 4px 0px rgba(26, 20, 16, 0.18);
    text-decoration: none;
    
    &:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0px rgba(26, 20, 16, 0.25);
        transition: all 0.2s ease;
    }
    }

    .card-label {
    font-family: map.get(typography.$fonts, subtitle);
    font-size: .75rem;
    font-weight: bold;
    color: map.get(variables.$colours, text-muted);
    margin: 0 0 map.get(variables.$spacing, sm) 0;
    }

    .card-value {
    font-family: map.get(typography.$fonts, body);
    font-size: 12px;
    font-weight: 600;
    color: map.get(variables.$colours, text-primary);
    margin: 0;
    }
</style>