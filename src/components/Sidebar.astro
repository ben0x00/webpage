---
const {
    name = { first: 'Ben', last: 'Toon' },
    bioText = 
    'I\'m a second-year Computer Science student at Lancaster University. \n I\'m interested in all of computing, technology, science, and philosophy. If you\'d like to get in touch, feel free to use email or GitHub below :)',
    taglineTexts = ['Computer Science — Lancaster University / Bedfordshire, UK'],
} = Astro.props;
---

<aside class="content-left">
    <div class="profile-header">
        <div class="profile-name">
            <a class="name-line1" style="color: var(--colour-accent)" href="/">
                {name.first}
            </a>
            <a class="name-line2" style="color: var(--colour-secondary)" href="/">
                {name.last}
            </a>
        </div>

        <div class="profile-tagline">
            {taglineTexts.map((tagline: string, i: number) => (
                <p class="tagline-text" data-index={i}>{tagline}</p>
            ))}
        </div>
    </div>

    <hr class="divider-thin" />

    <section class="profile-bio">
        <h2 class="section-label">Bio</h2>
        <p class="bio-text">{bioText}</p>
    </section>

    <hr class="divider-thin" />

    <p class="credit-text">Designed &amp; built by me</p>
</aside>

<style lang="scss">
    @use 'sass:map';
    @use '../styles/typography';
    @use '../styles/variables';

    .profile-header {
        display: flex;
        flex-direction: column;
        gap: map.get(variables.$spacing, sm);
    }

    .profile-name {
        display: flex;
        flex-direction: row;
        gap: map.get(variables.$spacing, 2xs);
        margin: map.get(variables.$spacing, 2xs) 0 0;
        line-height: 1.25em;
    }

    .name-line1 {
        font-family: map.get(typography.$fonts, display);
        font-size: var(--step-4);
        text-decoration: none;
        color: var(--colour-accent);
        margin: 0;
    }

    .name-line2 {
        font-family: map.get(typography.$fonts, display);
        font-size: var(--step-4);
        text-decoration: none;
        color: var(--colour-secondary);
        letter-spacing: 0.04em;
    }

    .profile-tagline {
        display: flex;
        flex-direction: column;
        gap: map.get(variables.$spacing, 2xs);
    }

    .tagline-text {
        font-family: map.get(typography.$fonts, mono);
        font-size: var(--step-0);
        color: map.get(variables.$colours, text-muted);
        letter-spacing: 0.04em;
        margin: 0;
    }

    .profile-bio {
        padding-top: map.get(variables.$spacing, lg);
    }

    // Pinned to the bottom of the rail on desktop; inline on mobile.
    .credit-text {
        margin: auto 0 0;
        padding-top: map.get(variables.$spacing, lg);

    }

    @media (max-width: 48rem) {
        .profile-header {
            flex-direction: column;
            gap: map.get(variables.$spacing, sm);
        }

        .profile-name {
            display: flex;
            flex-direction: row;
            align-items: baseline;
            gap: map.get(variables.$spacing, 2xs);
        }

        .credit-text {
            display: none;
        }
    }
</style>