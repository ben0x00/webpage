---
const { name = {first: "Ben", last: "Toon"}, 
bioText = "Bio bio bio text",
taglineTexts = ["CS - Lancaster"]} = Astro.props;
---

<section class="content-left">
    <header class="profile-header">
        <h1 class="profile-name">
            <span class="name-line1">{name.first}</span>
            <span class="name-line2">{name.last}</span>
        </h1>
    </header>

    <div class="profile-tagline">
        {taglineTexts.map((any) => <p class="tagline-text">{ any }</p>)}
    </div>

    <div class="divider-thin"></div>

    <section class="profile-bio">
        <h2 class="section-label">BIO</h2>
        <p class="bio-text"> { bioText } </p>
    </section>

    <div class="divider-thin"></div>

    <div class="credit-text">Designed and programmed myself ❤️</div>
</section>