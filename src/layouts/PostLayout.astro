---
import Contents from '../components/Contents.astro'
import NavigationBar from '../components/NavigationBar.astro'

const { frontmatter } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Ben's Site</title>
    <link rel="stylesheet" href="workbench-font.css">
</head>


<body>

    <main id="app-container">
        <section id="page-main">

            <Contents titleText={ titleText }>
                <slot />
            </Contents>

        </section>

        <NavigationBar />

    </main>

</body>


</html>