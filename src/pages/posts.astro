---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = Object.values(
    import.meta.glob('./posts/*.md', { eager: true }),
) as Array<{ url?: string; frontmatter: Record<string, string> }>;

// Newest first; frontmatter dates are DD/MM/YYYY.
const toTime = (date?: string) => {
    if (!date) return 0;
    const [day, month, year] = date.split('/').map(Number);
    return new Date(year, month - 1, day).getTime();
};

const sorted = posts.sort(
    (a, b) => toTime(b.frontmatter.pubDate) - toTime(a.frontmatter.pubDate),
);
---

<BaseLayout titleText="Posts" description="Writing by Ben Toon.">
    {sorted.length === 0 ? (
        <p class="body">No posts yet — check back soon.</p>
    ) : (
        <ul class="post-list">
            {sorted.map((post) => (
                <li>
                    <a class="post-link" href={post.url}>
                        <span class="post-title">{post.frontmatter.title}</span>
                        {post.frontmatter.pubDate && (
                            <span class="post-date">{post.frontmatter.pubDate}</span>
                        )}
                        {post.frontmatter.description && (
                            <span class="post-description">{post.frontmatter.description}</span>
                        )}
                    </a>
                </li>
            ))}
        </ul>
    )}
</BaseLayout>

<style lang="scss">
    @use 'sass:map';
    @use '../styles/typography';
    @use '../styles/variables';

    .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .post-link {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0 map.get(variables.$spacing, md);
        align-items: baseline;
        padding: map.get(variables.$spacing, md) 0;
        border-bottom: map.get(variables.$border, hairline) solid map.get(variables.$colours, divider-light);
        text-decoration: none;
        color: inherit;
    }

    .post-title {
        @extend .subtitle;
        font-size: var(--step-2);
    }

    .post-link:hover .post-title {
        color: map.get(variables.$colours, accent);
    }

    .post-date {
        font-family: map.get(typography.$fonts, mono);
        font-size: var(--step--1);
        color: map.get(variables.$colours, text-muted);
        white-space: nowrap;
    }

    .post-description {
        grid-column: 1 / -1;
        font-family: map.get(typography.$fonts, body);
        font-size: var(--step-0);
        color: map.get(variables.$colours, text-secondary);
        line-height: 1.5;
        margin-top: map.get(variables.$spacing, xs);
    }
</style>